# ===== Agent 配置 =====
AGENT_USER_CITY=广州
AGENT_USER_ID=1002
# 单轮 Agent 防护栏：限制 LangGraph 递归步数和实际工具调用次数
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=6

# ===== MySQL 配置 =====
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=zhitong
# 仅限本地开发；生产环境应由运维预先创建数据库
AUTO_CREATE_DATABASE=true

# ===== JWT 配置 =====
JWT_SECRET_KEY=your_random_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ===== CORS =====
ALLOWED_ORIGINS=http://localhost:5173

# ===== DashScope (通义千问) =====
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ===== Coros MCP（仅用于用户主动点击同步） =====
# 当前接入 cygnusb/coros-mcp（社区版，固定提交见 scripts/install_coros_mcp.ps1）。
# 认证令牌由 `coros-mcp auth` / `coros-mcp auth-web` 写入操作系统安全存储；不要把密码或令牌提交到 .env。
# 建议先执行 .\scripts\install_coros_mcp.ps1，再使用以下隔离虚拟环境中的可执行文件。
COROS_MCP_COMMAND=[".\\.tools\\coros-mcp-venv\\Scripts\\python.exe", "-m", "app.integrations.coros_mcp_runner", "serve"]
COROS_MCP_SYNC_COMMAND=[".\\.tools\\coros-mcp-venv\\Scripts\\python.exe", "-m", "app.integrations.coros_mcp_runner", "sync"]
# 社区 MCP 的 SQLite 缓存目录。Provider Runner 在导入社区库前重定向其 cache，不改变 HOME/USERPROFILE。
COROS_MCP_CACHE_HOME=.tools/coros-mcp-home
# FitAgent 仅读取活动、日指标和睡眠数据，不允许 MCP 暴露写入工具或认证工具给 Agent。
COROS_MCP_TOOLSET=readonly
COROS_MCP_HIDE_AUTH_TOOLS=true
# 如确有非交互式认证需求，临时在终端环境设置 COROS_EMAIL / COROS_PASSWORD / COROS_REGION，认证后删除；
# 后端同步不依赖它们，优先使用 auth-web 后的安全存储令牌。

# ===== Qdrant（仅对后端私有网络开放） =====
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=change_me_for_non_local_deployments

# ===== 健康文档处理 =====
# 扫描 PDF 的全部页面都会处理；超过此上限会在调用模型前拒绝
HEALTH_DOCUMENT_MAX_PAGES=20
HEALTH_DOCUMENT_RENDER_DPI=200
HEALTH_DOCUMENT_FALLBACK_RENDER_DPI=300

# ===== 日志 =====
LOG_LEVEL=INFO

# ===== 调试开关 =====
DEBUG_MODE=false
