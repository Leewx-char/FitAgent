# ===== Agent 配置 =====
# 单轮 Agent 防护栏：限制 LangGraph 递归步数和实际工具调用次数
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=6

# ===== mem0 长期记忆（开源 SDK，复用下方 DeepSeek、DashScope 和 Qdrant 连接） =====
MEMORY_ENABLED=true
MEMORY_COLLECTION_PREFIX=fitagent_memory
# mem0 SQLite 变更日志和短期消息；备份时与专用 Qdrant 集合一起保存
MEMORY_STORAGE_PATH=storage/memory
# 留空时分别使用 config/models.yml 中的 DeepSeek 聊天与 DashScope 嵌入模型
MEMORY_LLM_MODEL=
MEMORY_EMBEDDING_MODEL=
# 默认 text-embedding-v1 为 1536 维；切换维度时使用新 collection 前缀
MEMORY_EMBEDDING_DIMENSIONS=1536
MEMORY_TOP_K=6
MEMORY_SCORE_THRESHOLD=0.2
MEMORY_CONTEXT_MAX_CHARS=2400
MEMORY_DEFAULT_TTL_DAYS=90
MEMORY_TIMEOUT_SECONDS=10
MEMORY_MAX_RETRIES=2
# 超过管理列表上限时明确报错，不静默漏项
MEMORY_MAX_LIST_ITEMS=1000

# ===== MySQL 配置 =====
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=zhitong

# ===== JWT 配置 =====
JWT_SECRET_KEY=your_random_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ===== CORS =====
ALLOWED_ORIGINS=http://localhost:5173

# ===== DashScope (通义千问) =====
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ===== DeepSeek（官方聊天 API） =====
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ===== 官方 COROS 远程 MCP（按请求实时读取） =====
# 生产环境必须使用 HTTPS 回调地址；请先在预发完成官方 OAuth 动态注册验证。
COROS_MCP_GATEWAY_URL=https://mcp.coros.com/mcp
COROS_OAUTH_REDIRECT_URI=https://api.example.com/api/coros/callback
# 回跳目标由服务端配置，不接受浏览器传入的任意 URL。
COROS_OAUTH_POST_CONNECT_REDIRECT_URI=https://app.example.com/dashboard
# 用 `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"` 生成。
# 不要提交真实密钥、授权码、access token、refresh token 或账户密码。
COROS_TOKEN_ENCRYPTION_KEY=
COROS_OAUTH_TIMEOUT_SECONDS=15
COROS_MCP_TIMEOUT_SECONDS=30

# ===== Qdrant（仅对后端私有网络开放） =====
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=change_me_for_non_local_deployments

# ===== Weatherstack（天气工具） =====
# 未配置时天气工具会安全降级，但无法返回实时天气数据。
WEATHERSTACK_ACCESS_KEY=your_weatherstack_access_key_here

# ===== 健康文档处理 =====
# 扫描 PDF 的全部页面都会处理；超过此上限会在调用模型前拒绝
HEALTH_DOCUMENT_MAX_PAGES=20
HEALTH_DOCUMENT_RENDER_DPI=200
HEALTH_DOCUMENT_FALLBACK_RENDER_DPI=300

# ===== 日志 =====
LOG_LEVEL=INFO

# ===== 调试开关 =====
DEBUG_MODE=false
